// ============ PLANEADOR ============
function renderPlanner(){
    let b = document.getElementById("plannerBox"); if (!b) return;
    let showSopa = document.getElementById("showSopa")?.checked ?? true;
    let showEntrada = document.getElementById("showEntrada")?.checked ?? true;
    let showSobremesa = document.getElementById("showSobremesa")?.checked ?? true;
    let byType = {};
    mealTypes.forEach(t => { byType[t] = Object.entries(recipes).filter(([n, r]) => { let type = r.type || 'Prato Principal'; if (t === 'almoço' || t === 'jantar') return type === 'Prato Principal'; return type === t.charAt(0).toUpperCase() + t.slice(1); }); });
    let h = ""; let dayNames = currentLanguage === 'pt' ? days : daysEn;
    for (let i = 0; i < 7; i++) {
        let d = days[i], dn = dayNames[i];
        h += `<div class="day-card"><b>${dn}</b>`;
        for (let m of ['almoço', 'jantar']) { let id = `${d}_${m}`, sel = plan[id] || ""; let opts = (byType[m] || []).map(([n]) => `<option value="${n}" ${sel===n?'selected':''}>${n}</option>`).join(''); h += `<div class="meal-label">${mealTypeLabels[m]}</div><select id="${id}" onchange="updatePlan('${id}', this.value)"><option value="">-- Selecionar --</option>${opts}</select>`; }
        let opt = []; if (showSopa) opt.push('sopa'); if (showEntrada) opt.push('entrada'); if (showSobremesa) opt.push('sobremesa');
        opt.forEach(m => { let id = `${d}_${m}`, sel = plan[id] || "", en = plan[`${d}_${m}_enabled`] !== false; let opts = (byType[m] || []).map(([n]) => `<option value="${n}" ${sel===n?'selected':''}>${n}</option>`).join(''); h += `<div class="optional-meal"><input type="checkbox" id="${id}_check" ${en?'checked':''} onchange="toggleOptionalMeal('${d}','${m}',this.checked)"><label>${mealTypeLabels[m]}</label><select id="${id}" onchange="updatePlan('${id}', this.value)" ${en?'':'disabled'}><option value="">-- Opcional --</option>${opts}</select></div>`; });
        h += `</div>`;
    }
    b.innerHTML = h;
}
function toggleOptionalMeal(d,m,e){plan[`${d}_${m}_enabled`]=e;let s=document.getElementById(`${d}_${m}`);if(s)s.disabled=!e;if(!e){plan[`${d}_${m}`]="";s.value="";}save();}
function updatePlan(i,v){plan[i]=v;save();}
function autoPlan(){normalizeRecipes();let p=Object.entries(recipes).filter(([n,r])=>(r.type||'Prato Principal')==='Prato Principal');if(!p.length){alert("Adicione pratos!");return;}for(let d of days){plan[`${d}_almoço`]=p[Math.floor(Math.random()*p.length)][0];plan[`${d}_jantar`]=p[Math.floor(Math.random()*p.length)][0];}save();renderPlanner();alert("Planeamento gerado!");}
function clearPlan(){if(confirm("Limpar?")){plan={};save();renderPlanner();}}

// ============ LISTA DE COMPRAS ============
function initShoppingFilters(){ let d=document.getElementById("shoppingDayFilter");d.innerHTML='<option value="">Todos</option>';let dn=currentLanguage==='pt'?days:daysEn;days.forEach((day,i)=>d.innerHTML+=`<option value="${day}">${dn[i]}</option>`); let m=document.getElementById("shoppingMealFilter");m.innerHTML='<option value="">Todas</option>';mealTypes.forEach(t=>m.innerHTML+=`<option value="${t}">${mealTypeLabels[t]}</option>`); }
function updateShoppingMealFilter(){filterShoppingByMeal();}
function filterShoppingByMeal(){ let day=document.getElementById("shoppingDayFilter").value, meal=document.getElementById("shoppingMealFilter").value; if(day&&meal){let rn=plan[`${day}_${meal}`],en=meal==='almoço'||meal==='jantar'||plan[`${day}_${meal}_enabled`]!==false; if(rn&&en){document.getElementById("shoppingFilterInfo").innerHTML=`<b>🍽️ ${day} - ${mealTypeLabels[meal]} (${rn})</b>`;document.getElementById("shoppingFilterInfo").style.display="block";generateFilteredList(day,meal);} else{document.getElementById("shoppingFilterInfo").innerHTML=`<b>⚠️ Nenhuma receita</b>`;document.getElementById("shoppingFilterInfo").style.display="block";generateFilteredList(null,null);} }else{document.getElementById("shoppingFilterInfo").style.display="none";generateFilteredList(null,null);} }

function generateFilteredList(fd,fm){
    let list=new Map();
    for(let d of days){for(let m of mealTypes){if(fd&&fm&&(d!==fd||m!==fm))continue;if(m!=='almoço'&&m!=='jantar'&&plan[`${d}_${m}_enabled`]===false)continue;let r=recipes[plan[`${d}_${m}`]];if(!r?.ing)continue;for(let i of r.ing){let n=extractIngredientName(i);if(!n)continue;let{value,unit,type}=extractQuantityWithUnit(i);let disp=unit?`${n} (${unit})`:n;if(type==='qb'){if(!list.has(disp))list.set(disp,{needed:0,unit:'q.b.',displayText:'q.b.',baseName:n,isQB:true});}else{let cur=list.get(disp)||{needed:0,unit,baseName:n,isQB:false};cur.needed+=value;list.set(disp,cur);}}}}
    let total=0,totalEst=0;
    for(let[k,d]of list){ 
        let foundStock=0; 
        for(let[sk,sq]of Object.entries(stock)){ 
            let sn=sk.toLowerCase().replace(/\s*\([^)]*\)/g,'').trim(); 
            if(sn===d.baseName.toLowerCase()||sn.includes(d.baseName.toLowerCase())||d.baseName.toLowerCase().includes(sn)){foundStock=sq;break;} 
        }
        if(d.isQB){if(foundStock>0){d.satisfied=true;}else{d.needed=1;d.displayText='q.b.';total++;}}
        else{d.needed=Math.max(0,d.needed-foundStock);if(d.needed>0){d.displayText=formatQuantity(d.needed,d.unit);total++;let qm=d.displayText.match(/^[\d,]+/);if(qm){let qty=parseFloat(qm[0].replace(',','.'));totalEst+=qty*(itemPrices[k]||0);}}}
    }
    for(let[k,d]of list){if(d.isQB){if(d.satisfied)list.delete(k);}else if(d.needed<=0)list.delete(k);}
    let groups=new Map(); for(let[i,d]of list){let c=categorizeFood(i);if(!groups.has(c))groups.set(c,[]);groups.get(c).push({item:i,displayText:d.displayText||formatQuantity(d.needed,d.unit)});}
    let sorted=getCategoryOrder().filter(c=>groups.has(c));
    let h=list.size===0?`<p style='text-align:center;padding:40px;background:var(--bg-card);border-radius:8px;'>✅ Nada a comprar!</p>`:"";
    h=`<div style="display:flex;flex-direction:column;gap:18px;">${h}`;
    for(let c of sorted){let items=groups.get(c).sort((a,b)=>a.item.localeCompare(b.item));let sec=storeSections[c]||'';h+=`<div style="background:var(--bg-card);border-radius:12px;overflow:hidden;box-shadow:var(--shadow);"><h3 style="margin:0;padding:14px 18px;background:var(--section-bg);border-bottom:3px solid var(--accent);">${c} ${sec?`<span style="font-size:14px;">(${sec})</span>`:''}</h3><table class="shopping-table"><thead><tr><th style="width:40px;"></th><th>Produto</th><th style="width:120px;">Qtd</th><th style="width:100px;">Preço</th></tr></thead><tbody>`;
    items.forEach(i=>{let price=itemPrices[i.item]||0,it=0;if(i.displayText!=='q.b.'){let m=i.displayText.match(/^[\d,]+/);if(m)it=parseFloat(m[0].replace(',','.'))*price;}h+=`<tr><td><input type="checkbox" onchange="toggleCheckItem(this);updateStats()"></td><td><strong>${favorites[i.item]?'⭐ ':''}${i.item}</strong></td><td>${i.displayText}</td><td>${price>0?it.toFixed(2)+' €':'-'}</td></tr>`;});h+=`</tbody></table></div>`;}
    h+=`</div>`;document.getElementById("list").innerHTML=h; document.getElementById("totalItems").textContent=total; document.getElementById("estimatedTotal").textContent=totalEst.toFixed(2)+' €'; updateStats();
}
function updateStats(){let c=document.querySelectorAll('#list input[type="checkbox"]:checked').length;document.getElementById("checkedItems").textContent=c;}
function clearShoppingFilter(){document.getElementById("shoppingDayFilter").value='';document.getElementById("shoppingMealFilter").value='';document.getElementById("shoppingFilterInfo").style.display="none";generateFilteredList(null,null);}
function generateList(){clearShoppingFilter();}
function toggleCheckItem(cb){cb.closest('tr').classList.toggle('checked-item',cb.checked);updateStats();}
function markAllChecked(){document.querySelectorAll('#list input[type="checkbox"]').forEach(cb=>{cb.checked=true;cb.closest('tr')?.classList.add('checked-item');});updateStats();}
function unmarkAllChecked(){document.querySelectorAll('#list input[type="checkbox"]').forEach(cb=>{cb.checked=false;cb.closest('tr')?.classList.remove('checked-item');});updateStats();}

// ============ DESPENSA ============
function initStockFilters(){ let cats=new Set();Object.keys(stock).forEach(i=>cats.add(categorizeFood(i)));let s=document.getElementById("stockCategoryFilter");s.innerHTML='<option value="">Todas</option>';getCategoryOrder().filter(c=>cats.has(c)).forEach(c=>s.innerHTML+=`<option>${c}</option>`); let d=document.getElementById("stockDayFilter");d.innerHTML='<option value="">Selecione</option>';let dn=currentLanguage==='pt'?days:daysEn;days.forEach((day,i)=>d.innerHTML+=`<option value="${day}">${dn[i]}</option>`); updateStockMealFilter(); }
function updateStockMealFilter(){ let day=document.getElementById("stockDayFilter").value;let m=document.getElementById("stockMealFilter");m.innerHTML='<option value="">Selecione</option>'; if(day){mealTypes.forEach(t=>{let en=t==='almoço'||t==='jantar'||plan[`${day}_${t}_enabled`]!==false;let has=!!plan[`${day}_${t}`];if(has&&en)m.innerHTML+=`<option value="${t}">${mealTypeLabels[t]}</option>`;});} applyStockFilters(); }
function applyStockFilters(){
    let search=document.getElementById("stockSearch").value.toLowerCase(), cat=document.getElementById("stockCategoryFilter").value, qty=document.getElementById("stockQuantityFilter").value;
    let hide=document.getElementById("hideZeroStock").checked, fav=document.getElementById("showFavoritesOnly")?.checked||false;
    let day=document.getElementById("stockDayFilter").value, meal=document.getElementById("stockMealFilter").value, mealIng=null;
    if(day&&meal){let r=recipes[plan[`${day}_${meal}`]];if(r){mealIng=new Set();r.ing.forEach(i=>{let n=extractIngredientName(i);if(n)mealIng.add(n.toLowerCase());});document.getElementById("stockMealInfo").innerHTML=`<b>🍽️ ${plan[`${day}_${meal}`]}</b>`;document.getElementById("stockMealInfo").style.display="block";}}else{document.getElementById("stockMealInfo").style.display="none";}
    let filtered=Object.entries(stock).filter(([i,q])=>{
        if(search&&!i.toLowerCase().includes(search))return false;
        if(cat&&categorizeFood(i)!==cat)return false;
        if(qty==='zero'&&q!==0)return false;
        if(qty==='low'&&(q>=1||q===0))return false;
        if(qty==='medium'&&(q<1||q>5))return false;
        if(qty==='high'&&q<=5)return false;
        if(qty==='gt0'&&q<=0)return false;
        if(hide&&q===0)return false;
        if(fav&&!favorites[i])return false;
        if(mealIng&&!mealIng.has(extractIngredientName(i).toLowerCase()))return false;
        return true;
    });
    let groups=new Map();filtered.forEach(([i,q])=>{let c=categorizeFood(i);if(!groups.has(c))groups.set(c,[]);let match=i.match(/\(([^)]+)\)/);let unit=match?match[1]:'';let displayName=match?i.replace(/\s*\([^)]+\)/,'').trim():i;groups.get(c).push({item:i,displayName:displayName,qtd:q,unit:unit});});
    let sorted=getCategoryOrder().filter(c=>groups.has(c));
    document.getElementById("stockTotalItems").textContent=filtered.length; document.getElementById("stockZeroItems").textContent=filtered.filter(([i,q])=>q===0).length; document.getElementById("stockLowItems").textContent=filtered.filter(([i,q])=>q>0&&q<1).length;
    let h=filtered.length===0?`<p style='text-align:center;padding:40px;'>📦 Nenhum item</p>`:"";
    h=`<div style="display:flex;flex-direction:column;gap:18px;">${h}`;
    for(let c of sorted){let items=groups.get(c).sort((a,b)=>a.displayName.localeCompare(b.displayName));h+=`<div style="background:var(--bg-card);border-radius:12px;overflow:hidden;"><h3 style="margin:0;padding:14px 18px;background:var(--section-bg);border-bottom:3px solid var(--accent);">${c}</h3><table><thead><tr><th>Produto</th><th style="width:140px;">Quantidade</th><th style="width:100px;">Preço</th><th style="width:80px;"></th></tr></thead><tbody>`;
    items.forEach(i=>{let badge=i.qtd===0?'<span class="warning-badge">0</span>':(i.qtd<1?'<span class="warning-badge">Pouco</span>':'<span class="stock-ok">OK</span>');h+=`<tr><td><strong>${favorites[i.item]?'⭐ ':''}${i.displayName}</strong> ${badge}</td><td><input type="number" value="${i.qtd}" min="0" step="1" onchange="updateStock('${i.item.replace(/'/g,"\\'")}',this.value)" style="width:70px;"> <span>${i.unit}</span></td><td><input type="number" value="${itemPrices[i.item]||''}" min="0" step="0.01" placeholder="€" onchange="updatePrice('${i.item.replace(/'/g,"\\'")}',this.value)" style="width:70px"></td><td><button onclick="toggleFavorite('${i.item.replace(/'/g,"\\'")}')" class="btn-small">⭐</button><button onclick="removeStockItem('${i.item.replace(/'/g,"\\'")}')" class="btn-danger btn-small">🗑️</button></td></tr>`;});h+=`</tbody></table></div>`;}
    h+=`</div>`;document.getElementById("stockBox").innerHTML=h;
}
function clearAllStockFilters(){document.getElementById("stockSearch").value='';document.getElementById("stockCategoryFilter").value='';document.getElementById("stockQuantityFilter").value='all';document.getElementById("hideZeroStock").checked=false;if(document.getElementById("showFavoritesOnly"))document.getElementById("showFavoritesOnly").checked=false;document.getElementById("stockDayFilter").value='';document.getElementById("stockMealFilter").value='';document.getElementById("stockMealInfo").style.display="none";applyStockFilters();}
function clearStockMealFilter(){document.getElementById("stockDayFilter").value='';document.getElementById("stockMealFilter").value='';document.getElementById("stockMealInfo").style.display="none";applyStockFilters();}
function updateStock(n,v){let val=parseFloat(v);val<=0?delete stock[n]:stock[n]=val;save();applyStockFilters();}
function updatePrice(n,v){let val=parseFloat(v);if(val>0)itemPrices[n]=val;else delete itemPrices[n];save();}
function toggleFavorite(i){favorites[i]=!favorites[i];save();applyStockFilters();}
function removeStockItem(i){if(confirm(`Remover "${i}"?`)){delete stock[i];delete favorites[i];save();applyStockFilters();}}
function syncStockWithPlanner(){ for(let d of days){ for(let m of mealTypes){ if(m!=='almoço'&&m!=='jantar'&&plan[`${d}_${m}_enabled`]===false)continue; let r=recipes[plan[`${d}_${m}`]]; if(!r?.ing)continue; for(let i of r.ing){ let n=extractIngredientName(i); let {unit}=extractQuantityWithUnit(i); if(n){ let key=unit?`${n} (${unit})`:n; if(!Object.keys(stock).some(k=>k.toLowerCase().includes(n.toLowerCase())))stock[key]=0; } } } } save();initStockFilters();applyStockFilters();alert("✅ Sincronizado!"); }
function addMissingToStock(){let a=0;document.querySelectorAll('#list tbody tr').forEach(r=>{let n=r.cells[1]?.textContent.replace('⭐','').trim();let q=r.cells[2]?.textContent;if(n&&q&&q!=='q.b.'){let m=q.match(/[\d,]+/);if(m){let qty=parseFloat(m[0].replace(',','.'));let k=Object.keys(stock).find(x=>x.toLowerCase().includes(extractIngredientName(n).toLowerCase()))||n;stock[k]=(stock[k]||0)+qty;a++;}}});save();initStockFilters();applyStockFilters();alert(`${a} itens adicionados!`);}
function addStockItem(){ let i=prompt("Nome do produto:"); if(!i)return; let unit=prompt("Unidade (g, kg, ml, L, colher, q.b.):", "g"); let q=prompt("Quantidade:", "1"); if(q&&!isNaN(q)){ let key=unit?`${i} (${unit})`:i; stock[key]=(stock[key]||0)+parseInt(q); save();initStockFilters();applyStockFilters(); } }
function consolidateStock(){let ns={},c=false;for(let[i,q]of Object.entries(stock)){let b=i.replace(/\s*\([^)]*\)/g,'').trim();if(ns[b]){ns[b]+=q;c=true;}else ns[b]=q;}if(c){stock=ns;save();applyStockFilters();alert("✅ Consolidado!");}else alert("✅ Sem duplicados!");}
function clearAllStock(){if(confirm("⚠️ Apagar TODOS os itens da despensa?")){stock={};save();initStockFilters();applyStockFilters();alert("✅ Despensa limpa!");}}

// ============ CONFIGURAÇÕES ============
function renderSettings(){ document.getElementById("languageSelect").value = currentLanguage; applyTheme(); renderTabOrderList(); renderCategoryOrder(); renderStoreSections(); const fb=JSON.parse(localStorage.getItem("firebaseConfig")||"{}");if(fb.url)document.getElementById("firebaseUrl").value=fb.url;if(fb.key)document.getElementById("firebaseKey").value=fb.key; }
function renderTabOrderList(){ let h='<div>'; tabOrder.forEach((id,i)=>{h+=`<div class="category-item"><span style="flex:1;">${tabLabels[id]()}</span><button onclick="moveTabUp('${id}')" ${i===0?'disabled':''} class="btn-small">⬆️</button><button onclick="moveTabDown('${id}')" ${i===tabOrder.length-1?'disabled':''} class="btn-small">⬇️</button></div>`;}); h+='</div>';document.getElementById("tabOrderList").innerHTML=h; }
function moveTabUp(id){let i=tabOrder.indexOf(id);if(i>0){[tabOrder[i-1],tabOrder[i]]=[tabOrder[i],tabOrder[i-1]];save();renderTabs();renderTabOrderList();}}
function moveTabDown(id){let i=tabOrder.indexOf(id);if(i<tabOrder.length-1){[tabOrder[i],tabOrder[i+1]]=[tabOrder[i+1],tabOrder[i]];save();renderTabs();renderTabOrderList();}}
function resetTabOrder(){tabOrder=[...defaultTabOrder];save();renderTabs();renderTabOrderList();}
function renderCategoryOrder(){ let o=getCategoryOrder(),h='<div>'; o.forEach((c,i)=>{h+=`<div class="category-item"><span style="flex:1;">${c}</span><button onclick="moveCategoryUp('${c}')" ${i===0?'disabled':''} class="btn-small">⬆️</button><button onclick="moveCategoryDown('${c}')" ${i===o.length-1?'disabled':''} class="btn-small">⬇️</button></div>`;}); h+='</div>';document.getElementById("categoryOrderList").innerHTML=h; }
function moveCategoryUp(c){let i=categoryOrder.indexOf(c);if(i>0){[categoryOrder[i-1],categoryOrder[i]]=[categoryOrder[i],categoryOrder[i-1]];save();renderCategoryOrder();}}
function moveCategoryDown(c){let i=categoryOrder.indexOf(c);if(i<categoryOrder.length-1){[categoryOrder[i],categoryOrder[i+1]]=[categoryOrder[i+1],categoryOrder[i]];save();renderCategoryOrder();}}
function resetCategoryOrder(){categoryOrder=[...defaultCategoryOrder];save();renderCategoryOrder();}
function renderStoreSections(){let o=getCategoryOrder(),h='<table><thead><tr><th>Categoria</th><th>Secção</th></tr></thead><tbody>';o.forEach(c=>{h+=`<tr><td>${c}</td><td><input type="text" value="${storeSections[c]||''}" placeholder="Ex: Corredor 3" onchange="updateStoreSection('${c}',this.value)"></td></tr>`;});h+='</tbody></table>';document.getElementById("storeSections").innerHTML=h;}
function updateStoreSection(c,v){if(v.trim())storeSections[c]=v.trim();else delete storeSections[c];save();}

// ============ IMPORTAÇÃO/EXPORTAÇÃO ============
function showImportTab(t){document.querySelectorAll('.import-tab').forEach(x=>x.style.display='none');document.getElementById('import'+t.charAt(0).toUpperCase()+t.slice(1)).style.display='block';}
function parseContent(c){let rec={};c.split("---").forEach(b=>{if(!b.trim())return;let l=b.split("\n"),n="",cat="",type="Prato Principal",ing=[],steps=[],img="",mode="";for(let line of l){line=line.trim();if(line.startsWith("==="))n=line.replace(/===/g,"").trim();else if(line.toLowerCase().startsWith("categoria:"))cat=line.replace(/categoria:/i,"").trim();else if(line.toLowerCase().startsWith("tipo:"))type=line.replace(/tipo:/i,"").trim();else if(line.toLowerCase().startsWith("imagem:"))img=line.replace(/imagem:/i,"").trim();else if(line.toLowerCase().includes("ingredientes"))mode="ing";else if(line.toLowerCase().includes("preparação"))mode="steps";else if(mode==="ing"&&line)ing.push(line.replace(/^[•\-]\s*/,"").trim());else if(mode==="steps"&&line)steps.push(line.replace(/^[•\-]\d*\.?\s*/,"").trim());}if(n)rec[n]={cat,type,img,ing,steps:steps.join("\n")};});return rec;}
function importFiles(){let f=document.getElementById("fileInput").files[0];if(!f)return;let r=new FileReader();r.onload=e=>{let imp=parseContent(e.target.result);pendingImport=imp;let h=`<p><b>${Object.keys(imp).length} receitas:</b></p>`;Object.entries(imp).forEach(([n,r])=>h+=`<div><b>${n}</b> (${r.type})</div>`);document.getElementById("previewContent").innerHTML=h;document.getElementById("importPreview").style.display="block";};r.readAsText(f,"UTF-8");}
function importFromText(){let t=document.getElementById("textInput").value.trim();if(!t)return;let imp=parseContent(t);if(Object.keys(imp).length){pendingImport=imp;let h=`<p><b>${Object.keys(imp).length} receitas:</b></p>`;Object.entries(imp).forEach(([n,r])=>h+=`<div><b>${n}</b> (${r.type})</div>`);document.getElementById("previewContent").innerHTML=h;document.getElementById("importPreview").style.display="block";}else alert("Formato inválido!");}
function confirmImport(){if(!pendingImport)return;Object.assign(recipes,pendingImport);save();renderRecipes();renderPlanner();document.getElementById("importPreview").style.display="none";alert("✅ Importado!");}
function cancelImport(){document.getElementById("importPreview").style.display="none";}
function exportRecipes(){let t="";for(let n in recipes){let r=recipes[n];t+=`=== ${n} ===\nCategoria: ${r.cat||''}\nTipo: ${r.type||'Prato Principal'}\nImagem: ${r.img||''}\n\nIngredientes:\n${r.ing.map(i=>`• ${i}`).join('\n')}\n\nPreparação:\n${r.steps.split('\n').map(s=>`- ${s}`).join('\n')}\n\n---\n\n`;}let b=new Blob(["\uFEFF"+t],{type:"text/plain"});let a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=`receitas_${new Date().toISOString().slice(0,10)}.txt`;a.click();}
function exportRecipesJSON(){let b=new Blob([JSON.stringify({recipes,stock,favorites,recipeFavorites,itemPrices,categoryOrder,tabOrder,storeSections,notes,recipeComments},null,2)],{type:"application/json"});let a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=`dados_${new Date().toISOString().slice(0,10)}.json`;a.click();}
function exportShoppingListCSV(){let i=[];document.querySelectorAll('#list tbody tr').forEach(r=>{let cb=r.querySelector('input[type="checkbox"]');let n=r.cells[1]?.textContent.replace('⭐','').trim();let q=r.cells[2]?.textContent;if(n)i.push(`${cb?.checked?'Sim':'Não'},${n},${q}`);});let b=new Blob(["\uFEFFComprado,Produto,Quantidade\n"+i.join('\n')],{type:"text/csv"});let a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=`lista_${new Date().toISOString().slice(0,10)}.csv`;a.click();}
function clearAllData(){if(confirm("⚠️ Apagar TUDO?")){localStorage.clear();recipes={};plan={};stock={};favorites={};recipeFavorites={};itemPrices={};categoryOrder=[...defaultCategoryOrder];tabOrder=[...defaultTabOrder];storeSections={};notes=[];recipeComments={};save();renderTabs();renderRecipes();renderPlanner();}}

