function renderCalendarView() { renderCalendarViewWithDate(calendarYear, calendarMonth); }
function changeCalendarMonth(delta) {
    calendarMonth += delta;
    if (calendarMonth > 11) { calendarMonth = 0; calendarYear++; }
    else if (calendarMonth < 0) { calendarMonth = 11; calendarYear--; }
    renderCalendarViewWithDate(calendarYear, calendarMonth);
}
function renderCalendarViewWithDate(year, month) {
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const today = new Date();
    const isCurrentMonth = today.getMonth() === month && today.getFullYear() === year;
    const startDay = firstDay === 0 ? 6 : firstDay - 1;
    const monthNames = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    let html = `<h4 style="text-align:center;margin:20px 0;">${monthNames[month]} ${year}</h4>`;
    html += '<div style="display:flex;gap:10px;margin-bottom:15px;justify-content:center;">';
    html += '<button onclick="changeCalendarMonth(-1)" class="btn-small">⬅️</button><button onclick="changeCalendarMonth(1)" class="btn-small">➡️</button>';
    html += '<button onclick="toggleCalendarView()" class="btn-small btn-warning">📋 Ver Semanal</button></div><div class="calendar-view">';
    const dayNames = currentLanguage === 'pt' ? ['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'] : ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    dayNames.forEach(d => html += `<div class="calendar-header">${d}</div>`);
    for (let i = 0; i < startDay; i++) html += '<div class="calendar-day" style="background:var(--bg-secondary);"></div>';
    for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(year, month, day);
        const dayOfWeek = date.getDay();
        const dayName = days[dayOfWeek === 0 ? 6 : dayOfWeek - 1];
        const isToday = isCurrentMonth && day === today.getDate() ? ' today' : '';
        html += `<div class="calendar-day${isToday}"><div class="day-num">${day}</div>`;
        const meals = [];
        for (let meal of mealTypes) {
            const planKey = `${dayName}_${meal}`;
            if (plan[planKey]) {
                const enabled = meal === 'almoço' || meal === 'jantar' || plan[`${dayName}_${meal}_enabled`] !== false;
                if (enabled) meals.push(`<div class="calendar-meal">${mealTypeLabels[meal].split(' ')[0]} ${plan[planKey]}</div>`);
            }
        }
        html += meals.join('') || '<div style="color:#999;font-size:10px;">-</div>';
        html += '</div>';
    }
    html += '</div>';
    document.getElementById("calendarView").innerHTML = html;
}

// ============ SINCRONIZAÇÃO ============
function sanitizeKey(key) { return key.replace(/[.$#[\]/]/g, '_').replace(/[()]/g, ''); }
function sanitizeObject(obj) { if (Array.isArray(obj)) return obj.map(item => sanitizeObject(item)); if (obj && typeof obj === 'object') { const cleaned = {}; for (let [key, value] of Object.entries(obj)) cleaned[sanitizeKey(key)] = sanitizeObject(value); return cleaned; } return obj; }
function setupFirebase() {
    const url = document.getElementById("firebaseUrl").value.trim();
    const key = document.getElementById("firebaseKey").value.trim();
    if (!url || !key) { alert("Insira URL e API Key!"); return; }
    try {
        if (!firebaseApp) { const config = { apiKey: key, databaseURL: url, projectId: "appmeal-alpha" }; firebaseApp = window.firebaseModules.initializeApp(config); }
        firebaseDb = window.firebaseModules.getDatabase(firebaseApp); syncEnabled = true;
        document.getElementById("syncText").textContent = "Online ☁️"; document.getElementById("syncStatus").classList.remove("offline");
        loadFromCloud(); localStorage.setItem("firebaseConfig", JSON.stringify({ url, key })); alert("✅ Conectado!");
    } catch (e) { alert("❌ Erro: " + e.message); }
}
function loadFromCloud() {
    if (!syncEnabled || !firebaseDb) return;
    const dataRef = window.firebaseModules.ref(firebaseDb);
    window.firebaseModules.get(dataRef).then((snapshot) => {
        if (snapshot.exists()) {
            const data = snapshot.val();
            if (data.recipes) recipes = data.recipes; if (data.plan) plan = data.plan; if (data.stock) stock = data.stock;
            if (data.favorites) favorites = data.favorites; if (data.recipeFavorites) recipeFavorites = data.recipeFavorites;
            if (data.itemPrices) itemPrices = data.itemPrices; if (data.storeSections) storeSections = data.storeSections;
            if (data.categoryOrder) categoryOrder = data.categoryOrder; if (data.tabOrder) tabOrder = data.tabOrder;
            if (data.notes) notes = data.notes; if (data.recipeComments) recipeComments = data.recipeComments;
            save(); renderTabs();
            if (document.getElementById("recipes").classList.contains("active")) renderRecipes();
            if (document.getElementById("stockTab").classList.contains("active")) { initStockFilters(); applyStockFilters(); }
            if (document.getElementById("shopping").classList.contains("active")) generateList();
            if (document.getElementById("planner").classList.contains("active")) renderPlanner();
            if (document.getElementById("notes").classList.contains("active")) renderNotes();
        } else { uploadAllData(); }
        listenToChanges();
    });
}
function disconnectFirebase() { syncEnabled = false; document.getElementById("syncText").textContent = "Offline"; document.getElementById("syncStatus").classList.add("offline"); }
function uploadAllData() { if (!syncEnabled || !firebaseDb) return; const updates = { '/recipes': sanitizeObject(recipes), '/plan': sanitizeObject(plan), '/stock': sanitizeObject(stock), '/favorites': sanitizeObject(favorites), '/recipeFavorites': sanitizeObject(recipeFavorites) }; window.firebaseModules.update(window.firebaseModules.ref(firebaseDb), updates).catch(e=>{}); }
function listenToChanges() { if (!syncEnabled || !firebaseDb) return; const dataRef = window.firebaseModules.ref(firebaseDb); window.firebaseModules.onValue(dataRef, (snapshot) => { const data = snapshot.val(); if (!data) return; let changed = false; if (data.recipes && JSON.stringify(data.recipes) !== JSON.stringify(recipes)) { recipes = data.recipes; changed = true; } if (data.recipeFavorites && JSON.stringify(data.recipeFavorites) !== JSON.stringify(recipeFavorites)) { recipeFavorites = data.recipeFavorites; changed = true; } if (changed) { save(); renderTabs(); if (document.getElementById("recipes").classList.contains("active")) renderRecipes(); } }); }
function manualSync() { if (syncEnabled) { uploadAllData(); alert("✅ Sincronizado!"); } else alert("Configure o Firebase primeiro!"); }

