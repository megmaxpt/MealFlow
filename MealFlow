<script>
// ============ DADOS ============
let recipes = JSON.parse(localStorage.getItem("recipes")) || {};
let plan = JSON.parse(localStorage.getItem("plan")) || {};
let stock = JSON.parse(localStorage.getItem("stock")) || {};
let favorites = JSON.parse(localStorage.getItem("favorites")) || {};
let recipeFavorites = JSON.parse(localStorage.getItem("recipeFavorites")) || {};
let itemPrices = JSON.parse(localStorage.getItem("itemPrices")) || {};
let storeSections = JSON.parse(localStorage.getItem("storeSections")) || {};
let notes = JSON.parse(localStorage.getItem("notes")) || [];
let recipeComments = JSON.parse(localStorage.getItem("recipeComments")) || {};

const defaultCategoryOrder = ["🥩 Carnes","🐟 Peixes e Marisco","🥦 Legumes e Vegetais","🍎 Frutas","🥛 Laticínios e Ovos","🍚 Grãos e Massas","🧂 Temperos e Ervas","🥫 Enlatados e Conservas","🍷 Bebidas","🍰 Sobremesas","🧂 Mercearia"];
let categoryOrder = JSON.parse(localStorage.getItem("categoryOrder")) || [...defaultCategoryOrder];
const defaultTabOrder = ["recipes","manage","data","planner","shopping","stockTab","notes","settings"];
let tabOrder = JSON.parse(localStorage.getItem("tabOrder")) || [...defaultTabOrder];
const tabLabels = {"recipes": () => "📚 Receitas", "manage": () => "➕ Gerir", "data": () => "📥 Dados", "planner": () => "📅 Planeador", "shopping": () => "🧾 Lista", "stockTab": () => "📦 Despensa", "notes": () => "📝 Notas", "settings": () => "⚙️ Config"};
const mealTypes = ["almoço","jantar","sopa","entrada","sobremesa"];
const mealTypeLabels = {"almoço":"🍽️ Almoço","jantar":"🍽️ Jantar","sopa":"🍲 Sopa","entrada":"🥗 Entrada","sobremesa":"🍰 Sobremesa"};
const days = ["Segunda","Terça","Quarta","Quinta","Sexta","Sábado","Domingo"];
const daysEn = ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"];

let currentLanguage = localStorage.getItem("language") || "pt";
let pendingImport = null, currentTypeFilter = '', currentFavFilter = false;
let firebaseApp = null, firebaseDb = null, syncEnabled = false;
let pendingPlannerRecipe = null;
let currentTheme = localStorage.getItem("theme") || "light";
let currentSkin = localStorage.getItem("skin") || "";
let showingCalendar = false;
let calendarMonth = new Date().getMonth();
let calendarYear = new Date().getFullYear();

// ============ FUNÇÕES AUXILIARES ============
function save(){ 
    localStorage.setItem("recipes",JSON.stringify(recipes)); 
    localStorage.setItem("plan",JSON.stringify(plan)); 
    localStorage.setItem("stock",JSON.stringify(stock)); 
    localStorage.setItem("favorites",JSON.stringify(favorites)); 
    localStorage.setItem("recipeFavorites",JSON.stringify(recipeFavorites)); 
    localStorage.setItem("itemPrices",JSON.stringify(itemPrices)); 
    localStorage.setItem("categoryOrder",JSON.stringify(categoryOrder)); 
    localStorage.setItem("tabOrder",JSON.stringify(tabOrder)); 
    localStorage.setItem("storeSections",JSON.stringify(storeSections)); 
    localStorage.setItem("notes",JSON.stringify(notes));
    localStorage.setItem("recipeComments",JSON.stringify(recipeComments));
    if (syncEnabled) uploadAllData(); 
}

function renderTabs() { 
    const top = document.getElementById("top"); 
    top.innerHTML = ''; 
    tabOrder.forEach(id => { 
        const tab = document.createElement("div"); 
        tab.className = "tab"; 
        tab.setAttribute("data-id", id); 
        tab.innerHTML = tabLabels[id](); 
        tab.onclick = () => showTab(id); 
        top.appendChild(tab); 
    }); 
    const active = document.querySelector(".container.active"); 
    if (active) { 
        const activeTab = Array.from(document.querySelectorAll(".tab")).find(t => t.dataset.id === active.id); 
        if (activeTab) activeTab.classList.add("active"); 
    } 
}

function showTab(id){ 
    document.querySelectorAll(".container").forEach(c=>c.classList.remove("active")); 
    document.getElementById(id).classList.add("active"); 
    document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active")); 
    const activeTab = Array.from(document.querySelectorAll(".tab")).find(t => t.dataset.id === id); 
    if (activeTab) activeTab.classList.add("active"); 
    if(id==="recipes")renderRecipes(); 
    else if(id==="stockTab"){initStockFilters();applyStockFilters();} 
    else if(id==="planner")renderPlanner(); 
    else if(id==="shopping"){initShoppingFilters();generateList();} 
    else if(id==="settings")renderSettings();
    else if(id==="notes")renderNotes();
}

function normalizeRecipes(){let c=false;Object.keys(recipes).forEach(n=>{if(!recipes[n].type){recipes[n].type='Prato Principal';c=true;}});if(c)save();}

function extractIngredientName(i) {
    let name = i.trim();
    
    // Remove "q.b." e variantes
    name = name.replace(/\s*\(?\s*q\.?\s*b\.?\s*\.?\s*\)?\s*/gi, '');
    name = name.replace(/\s*quanto\s+baste\s*/gi, '');
    
    // Remove quantidade + unidade + "de"
    name = name.replace(/^\s*\d+[.,]?\d*\s*(g|kg|ml|dl|l|cl|un|unidade|colher|chávena|xícara|pitada|ramo|dente|folha|lata|pacote|frasco|garrafa|copo)s?\s+(de\s+)?/gi, '');
    
    // Remove conteúdo entre parênteses (restos)
    name = name.replace(/\s*\([^)]*\)/g, '');
    
    // Remove "de" isolado no início
    name = name.replace(/^\s*de\s+/gi, '');
    
    // Singular/Plural - COMPLETO
    const pluralToSingular = {
        'cenouras': 'cenoura', 'cebolas': 'cebola', 'batatas': 'batata',
        'tomates': 'tomate', 'ovos': 'ovo', 'limões': 'limão',
        'laranjas': 'laranja', 'maçãs': 'maçã', 'bananas': 'banana',
        'morangos': 'morango', 'pimentos': 'pimento', 'cogumelos': 'cogumelo',
        'pepinos': 'pepino', 'alhos': 'alho', 'queijos': 'queijo',
        'iogurtes': 'iogurte', 'amêijoas': 'amêijoa', 'ervilhas': 'ervilha',
        'azeitonas': 'azeitona', 'nozes': 'noz', 'amêndoas': 'amêndoa',
        'passas': 'passa', 'framboesas': 'framboesa', 'cerejas': 'cereja',
        'ameixas': 'ameixa', 'pêras': 'pêra', 'pêssegos': 'pêssego',
        'mangas': 'manga', 'kiwis': 'kiwi', 'melancias': 'melancia',
        'melões': 'melão', 'abacaxis': 'abacaxi',
        'uvas': 'uva', 'figos': 'figo', 'tâmaras': 'tâmara',
        'castanhas': 'castanha', 'avelãs': 'avelã', 'pistáchios': 'pistáchio',
        'beterrabas': 'beterraba', 'nabos': 'nabo', 'rabanetes': 'rabanete',
        'courgettes': 'courgette', 'beringelas': 'beringela',
        'abóboras': 'abóbora', 'chuchus': 'chuchu',
        'espargos': 'espargo', 'alcachofras': 'alcachofra',
        'folhas': 'folha', 'ramos': 'ramo', 'dentes': 'dente',
        'latas': 'lata', 'pacotes': 'pacote', 'frascos': 'frasco',
        'garrafas': 'garrafa', 'copos': 'copo', 'chávenas': 'chávena',
        'xícaras': 'xícara', 'colheres': 'colher', 'pitadas': 'pitada',
    };
    
    // Aplica singular - verifica última palavra
    const words = name.split(' ');
    const lastWord = words[words.length - 1].toLowerCase();
    if (pluralToSingular[lastWord]) {
        words[words.length - 1] = pluralToSingular[lastWord];
        name = words.join(' ');
    }
    
    // Também verifica a primeira palavra
    const firstWord = words[0].toLowerCase();
    if (pluralToSingular[firstWord]) {
        words[0] = pluralToSingular[firstWord];
        name = words.join(' ');
    }
    
    return name.trim() || i;
}

function extractQuantityWithUnit(i){if(/q\.?\s*b\.?\s*\.?|quanto\s+baste|qb/i.test(i))return{value:0,unit:'q.b.',text:"q.b.",type:'qb'};let m=i.match(/(\d+[.,]?\d*)\s*([a-zA-ZÀ-ÿ]+)?/i);if(m)return{value:parseFloat(m[1].replace(',','.')),unit:m[2]||null,type:'quantity'};return{value:1,unit:'un',type:'count'};}
