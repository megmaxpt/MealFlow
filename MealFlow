function printPlanner(){let w=window.open('','_blank');let c=document.getElementById("plannerBox").cloneNode(true);c.querySelectorAll('select').forEach(s=>{let d=document.createElement('div');d.textContent=s.options[s.selectedIndex]?.text||'---';s.replaceWith(d);});w.document.write(`<html><head><title>Planeador</title><style>body{font-family:Arial}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.day-card{border:1px solid #ccc;padding:10px}</style></head><body><h1>Planeador</h1><div class="grid">${c.innerHTML}</div></body></html>`);w.document.close();w.print();}
function printShoppingList(){let w=window.open('','_blank');w.document.write(`<html><head><title>Lista</title></head><body><h2>Lista de Compras</h2>${document.getElementById("list").innerHTML}</body></html>`);w.document.close();w.print();}
function exportShoppingListPDF(){let c=document.createElement('div');c.innerHTML=`<h2>Lista de Compras</h2>${document.getElementById("list").innerHTML}`;html2pdf().set({margin:0.5,filename:`lista_${new Date().toISOString().slice(0,10)}.pdf`}).from(c).save();}

// ============ IMAGENS ============
function useRecipeNameForSearch(){let n=document.getElementById("nome").value.trim();if(!n)return;document.getElementById("aiSearchTerm").value=n;searchFoodImages();}
function selectImage(u){document.getElementById("img").value=u;document.getElementById("previewImg").src=u;document.getElementById("selectedImagePreview").style.display="block";document.getElementById("photoPreview").src=u;document.getElementById("photoPreview").style.display="block";}
async function searchFoodImages(){let t=document.getElementById("aiSearchTerm").value.trim()||document.getElementById("nome").value.trim();if(!t)return;let d=document.getElementById("aiImageResults");d.innerHTML='<div>🔍 A procurar...</div>';let imgs=[];try{let r=await fetch(`https://www.themealdb.com/api/json/v1/1/search.php?s=${encodeURIComponent(t)}`);let data=await r.json();if(data.meals)data.meals.slice(0,6).forEach(m=>imgs.push(m.strMealThumb));}catch(e){}if(!imgs.length)imgs=['https://www.themealdb.com/images/media/meals/1548772327.jpg','https://www.themealdb.com/images/media/meals/1542324232.jpg'];d.innerHTML='';imgs.forEach(u=>{let div=document.createElement('div');div.style.cursor='pointer';div.innerHTML=`<img src="${u}" style="width:120px;height:120px;object-fit:cover;border-radius:8px;" onclick="selectImage('${u}')">`;d.appendChild(div);});}

// ============ PWA ============
let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferredPrompt = e; document.getElementById('installBanner').style.display = 'block'; });
function installPWA() { if (deferredPrompt) { deferredPrompt.prompt(); deferredPrompt.userChoice.then(() => { document.getElementById('installBanner').style.display = 'none'; deferredPrompt = null; }); } else { alert('Use "Adicionar ao ecrã principal" no menu do navegador.'); } }

