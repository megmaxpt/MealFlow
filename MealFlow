.install-banner{background: var(--accent);color:white;padding:12px 20px;text-align:center;cursor:pointer;display:none;font-weight:500;}
.container{display:none;padding:25px;}
.container.active{display:block;}
.filters-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:25px;}
.filter-box{background: var(--filter-bg);padding:18px;border-radius:12px;border:1px solid var(--filter-border);box-shadow: var(--shadow);}
.filter-box h4{margin:0 0 15px 0;color: var(--filter-title);font-size:15px;font-weight:600;}
.filter-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:12px;}
.filter-row label{min-width:70px;font-weight:600;color:var(--filter-title);font-size:13px;}
.filter-row select,.filter-row input{width:auto;min-width:150px;padding:8px 12px;border:1px solid var(--filter-border);border-radius:8px;background: var(--input-bg);color: var(--text-primary);}
.stats-section{display:flex;gap:18px;flex-wrap:wrap;margin:20px 0;}
.stat-card{background: var(--stat-bg);padding:16px;border-radius:12px;border:1px solid var(--border-color);flex:1;min-width:130px;box-shadow: var(--shadow);}
.stat-card h4{margin:0 0 8px 0;font-size:13px;color:var(--text-secondary);font-weight:500;}
.stat-value{font-size:24px;font-weight:700;color:var(--accent);}
.recipes-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;flex-wrap:wrap;gap:15px;}
.recipes-stats{display:flex;gap:15px;}
