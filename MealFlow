        <div class="filter-group" style="margin-bottom:15px;"><label>Refeição:</label><select id="plannerMealSelect"><option value="almoço">🍽️ Almoço</option><option value="jantar">🍽️ Jantar</option><option value="sopa">🍲 Sopa</option><option value="entrada">🥗 Entrada</option><option value="sobremesa">🍰 Sobremesa</option></select></div>
        <div style="display:flex;gap:10px;"><button onclick="confirmAddToPlanner()" class="btn btn-success" style="flex:1;">✅ Adicionar</button><button onclick="closePlannerModal()" class="btn btn-outline">❌ Cancelar</button></div>
    </div>
</div>

