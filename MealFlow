.recipe-content{padding:18px;}
.recipe-title{font-size:17px;font-weight:700;margin-bottom:10px;color: var(--text-primary);}
.recipe-badges{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
.badge{padding:4px 12px;border-radius:15px;font-size:11px;font-weight:600;letter-spacing:0.3px;}
.badge-primary{background:var(--badge-primary);color:white;}
