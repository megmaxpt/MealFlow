.filter-chips{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0;}
.chip{padding:8px 18px;background: var(--chip-bg);border:2px solid var(--border-color);border-radius:25px;cursor:pointer;font-size:13px;font-weight:500;transition:all 0.2s ease;}
.chip:hover{border-color: var(--accent);transform: translateY(-1px);}
.chip.active{background: var(--accent);color:white;border-color: var(--accent);}
.chip-favorite{border-color: var(--warning);color: var(--warning-dark);}
.chip-favorite.active{background: var(--warning);color: #000;border-color: var(--warning);}
.recipes-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:25px;margin-top:25px;}
.recipe-card{background: var(--bg-card);border-radius:16px;overflow:hidden;box-shadow: var(--shadow);transition:all 0.3s ease;cursor:pointer;position:relative;border:1px solid var(--border-color);}
.recipe-card:hover{transform:translateY(-5px);box-shadow:0 8px 25px rgba(0,0,0,0.15);}
.recipe-card.favorite{border:2px solid var(--favorite-color);}
.recipe-image{width:100%;height:180px;background: var(--section-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;}
