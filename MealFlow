.checked-item{text-decoration:line-through;opacity:0.5;}
.warning-badge{background:var(--warning);color:#000;padding:3px 10px;border-radius:15px;font-size:11px;font-weight:600;}
.stock-ok{background:var(--success);color:white;padding:3px 10px;border-radius:15px;font-size:11px;font-weight:600;}
.category-order-section{background: var(--filter-bg);padding:18px;border-radius:12px;margin:18px 0;border:1px solid var(--border-color);box-shadow: var(--shadow);}
.category-item{display:flex;align-items:center;gap:12px;padding:10px;margin:6px 0;background: var(--bg-card);border:1px solid var(--border-color);border-radius:10px;}
#stockBox>div,#list>div{display:flex;flex-direction:column;gap:18px;}
#stockBox h3,#list h3{margin:0!important;padding:14px 18px!important;background: var(--section-bg)!important;border-bottom:3px solid var(--accent)!important;font-size:16px!important;font-weight:600!important;}
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background: var(--modal-overlay);z-index:1000;display:flex;align-items:center;justify-content:center;padding:25px;backdrop-filter: blur(3px);}
.modal-content{background: var(--bg-card);border-radius:20px;width:95%;max-width:1200px;max-height:95vh;overflow-y:auto;position:relative;box-shadow:0 25px 50px rgba(0,0,0,0.3);}
.modal-close{position:sticky;top:15px;right:15px;float:right;width:45px;height:45px;border-radius:50%;background: var(--danger);color:white;border:none;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10;}
.modal-body{padding:35px;}
.planner-modal,.share-modal{position:fixed;top:0;left:0;right:0;bottom:0;background: var(--modal-overlay);z-index:1001;display:flex;align-items:center;justify-content:center;padding:25px;}
.planner-modal-content,.share-modal-content{background: var(--bg-card);border-radius:20px;padding:35px;width:90%;max-width:500px;box-shadow:0 25px 50px rgba(0,0,0,0.3);}
.notes-container{background: var(--bg-card);border-radius:16px;padding:20px;margin-bottom:20px;box-shadow: var(--shadow);border:1px solid var(--border-color);}
.note-card{background: var(--filter-bg);padding:18px;border-radius:12px;margin:12px 0;border-left:4px solid var(--accent);position:relative;box-shadow: var(--shadow);}
.note-card h4{margin:0 0 12px 0;color:var(--text-primary);}
.note-card small{color:var(--text-secondary);display:block;margin-top:10px;}
.note-actions{position:absolute;top:12px;right:12px;}
.calendar-view{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:25px;}
.calendar-header{text-align:center;font-weight:600;padding:12px;background: var(--accent);color:white;border-radius:10px;}
.calendar-day{min-height:100px;padding:10px;background: var(--bg-card);border:1px solid var(--border-color);border-radius:10px;font-size:11px;}
.calendar-day.today{background: var(--filter-bg);border-color: var(--accent);box-shadow: 0 0 0 2px var(--accent-light);}
.calendar-day .day-num{font-weight:700;font-size:15px;margin-bottom:6px;color: var(--text-primary);}
.calendar-meal{font-size:10px;padding:2px 0;color: var(--text-secondary);}
.photo-upload-area{border:2px dashed var(--accent);padding:35px;text-align:center;border-radius:14px;cursor:pointer;margin:18px 0;background: var(--filter-bg);transition:all 0.3s;color: var(--text-secondary);}
.photo-upload-area:hover{background: var(--accent-light);color: white;}
.photo-preview{max-width:250px;max-height:250px;border-radius:12px;margin:12px 0;box-shadow: var(--shadow);}
h2{color: var(--text-primary);font-weight:700;}
h3{color: var(--text-primary);font-weight:600;margin-bottom:20px;}
.ai-image-section{border:2px dashed var(--border-color);padding:20px;border-radius:14px;margin:18px 0;background: var(--filter-bg);}
.ai-image-section h4{color: var(--filter-title);margin-bottom:15px;}
@media print{*{margin:0;padding:0}body{background:white}#top,button,.btn-group,.stock-controls,.tab,.filter-section,.install-banner{display:none!important}.container{display:block!important;padding:0!important}}
