        <button class="modal-close" onclick="closeRecipeModal()">✕</button>
        <div class="modal-body" id="recipeModalBody"></div>
    </div>
</div>

<div id="plannerModal" class="planner-modal" style="display:none;" onclick="closePlannerModal(event)">
    <div class="planner-modal-content" onclick="event.stopPropagation()">
        <h3 style="margin:0 0 20px 0;">📅 Adicionar ao Planeador</h3>
